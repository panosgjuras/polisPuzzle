.env
.env.*
!.env.example
config.local.yaml
configs/local/

# Project datasets
data/raw/*
data/interim/*
data/processed/*
data/output/*

# Preserve documentation inside data directories
!data/README.md
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/output/.gitkeep

